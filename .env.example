# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Required. Bot token from https://discord.com/developers/applications
# (Your bot -> Bot -> Reset Token). Keep it secret.
DISCORD_TOKEN=

# Where the SQLite database lives. The directory is created automatically.
DATABASE_URL=sqlite://data/bot.db?mode=rwc

# Comma separated user IDs that may run owner-only commands and bypass automod.
OWNER_IDS=

# While you are setting the bot up, put your server's ID here: slash commands
# register to that one guild instantly instead of taking up to an hour to
# appear globally. Remove it for production.
DEV_GUILD_ID=

# Prefix for the handful of prefix commands and all custom commands.
# Each server can override this with /config prefix.
BOT_PREFIX=!

# Optional. A LibreTranslate-compatible endpoint for /translate.
# Without it, /translate explains that it is not configured.
# TRANSLATE_API_URL=https://libretranslate.com/translate
# TRANSLATE_API_KEY=

# Optional. TrueType font used to draw rank cards. If this is unset the bot
# looks for assets/font.ttf and then the usual system fonts, and falls back to
# a text rank card when it finds none.
# RANK_CARD_FONT=assets/font.ttf

# Optional. A newline-separated list of phishing domains, fetched on startup
# and merged into the built-in list.
# PHISH_LIST_URL=https://raw.githubusercontent.com/example/list/main/domains.txt

# Optional. Logging filter. Default: mrtechtrivia_bot=info,serenity=warn
# RUST_LOG=mrtechtrivia_bot=debug,serenity=warn
